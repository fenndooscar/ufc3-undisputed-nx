# Nothing derived from the game is ever committed: its files, the code generated from default.xex, and the
# binaries built from that code.

# --- Game files ---------------------------------------------------------------
assets/
*.xex
*.xexp
*.iso
*.bin
*.big
*.bun
*.viv
*.nfsp

# --- Generated from the game --------------------------------------------------
generated/
app*/generated/
app*/src/copias_literales/
app*/src/ufc3-undisputed-nx_nativo_resplandor_*_spirv.h
app_*/

# --- Build output -------------------------------------------------------------
out/
build/
*.nro
*.nacp
*.elf
*.o
*.obj
*.a
*.log
*.err
shaders/wasm/out/

# --- Vendored third-party sources ---------------------------------------------
# Arrive through tools/fetch_thirdparty.py (~19,000 files, some of them symlinks
# and submodule markers). The seven files this port actually changed are already
# tracked, and .gitignore does not untrack anything, so they stay.
sdk/thirdparty/

# --- Tools --------------------------------------------------------------------
__pycache__/
*.pyc
.vs/
.vscode/
graphify-out/
mesa/mesa-switch
